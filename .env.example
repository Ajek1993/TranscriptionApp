# =============================================================================
# KONFIGURACJA ZMIENNYCH ŚRODOWISKOWYCH - TranscriptionApp
# =============================================================================
# Skopiuj ten plik jako .env i uzupełnij wartości
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Translation (Tłumaczenie kontekstowe)
# -----------------------------------------------------------------------------
# Klucz API do wybranego providera LLM
LLM_API_KEY=

# Base URL API (opcjonalnie - domyślnie używa oficjalnych endpointów)
# Przykłady:
#   OpenAI:    https://api.openai.com/v1
#   Ollama:    http://localhost:11434/v1
#   Anthropic: https://api.anthropic.com
#   api.z.ai:  https://api.z.ai/api/anthropic
LLM_BASE_URL=

# Model LLM do użycia
# Przykłady:
#   OpenAI:    gpt-4o-mini, gpt-4o, gpt-4-turbo
#   Ollama:    llama3.1, mistral, mixtral
#   Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514
#   api.z.ai:  GLM-4.7
LLM_MODEL=

# Format API: "openai" lub "anthropic"
# Automatycznie wykrywany z BASE_URL, ale można nadpisać
LLM_API_FORMAT=

# -----------------------------------------------------------------------------
# HuggingFace (dla WhisperX Speaker Diarization)
# -----------------------------------------------------------------------------
# Token HuggingFace do pobrania modeli diaryzacji
# Uzyskaj na: https://huggingface.co/settings/tokens
# Wymagane akceptowanie warunków modeli:
#   - https://huggingface.co/pyannote/speaker-diarization-3.1
#   - https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# -----------------------------------------------------------------------------
# PRZYKŁADOWE KONFIGURACJE
# -----------------------------------------------------------------------------

# --- OpenAI GPT ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Ollama (lokalny, darmowy) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama  # dowolna wartość, Ollama nie wymaga klucza

# --- Anthropic Claude ---
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-20250514

# --- api.z.ai z GLM-4.7 ---
# LLM_API_KEY=twój_klucz_z_api_z_ai
# LLM_BASE_URL=https://api.z.ai/api/anthropic
# LLM_MODEL=GLM-4.7
# LLM_API_FORMAT=anthropic


# -----------------------------------------------------------------------------
# DEBUGOWANIE PROMPTÓW LLM
# -----------------------------------------------------------------------------

LLM_DEBUG=1
